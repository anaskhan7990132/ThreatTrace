# Optional local settings. Copy to .env only if you need overrides.
THREATTRACE_HOST=127.0.0.1
THREATTRACE_PORT=5000
THREATTRACE_DEBUG=0
# Set a random value if you use a session-related feature in a local extension.
THREATTRACE_SECRET_KEY=replace-this-local-development-value

# Optional: Groq AI explanations (leave blank to keep AI disabled)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
